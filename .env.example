# Copy to .env and fill in — the app falls back to SQLite when unset.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon key>
SUPABASE_SERVICE_KEY=<service_role key>
# Supabase Postgres (transaction pooler) — enables the booking engine on PG.
# Leave unset to keep the local SQLite fallback. Never commit the real value.
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-1-<region>.pooler.supabase.com:6543/postgres?sslmode=require
SECRET_KEY=<long-random-string>
